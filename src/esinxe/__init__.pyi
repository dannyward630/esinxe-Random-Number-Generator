from typing import (
    Generic,
    Iterable,
    List,
    Optional,
    Sequence,
    SupportsIndex,
    SupportsInt,
    TypeVar,
    Union,
)

_T = TypeVar("_T")

__version__: str
MASK_64: int
UINT64_SIZE: int
GOLDEN_GAMMA: int
MAX_INT_VALUE: int
MAX_INT_THRESHOLD: int
FNV_OFFSET_BASIS: int
FNV_PRIME: int
V1_PREFIX: bytes

class Signed:
    @property
    def value(self) -> int: ...
    def __init__(self, value: SupportsIndex) -> None: ...

class Unsigned:
    @property
    def value(self) -> int: ...
    def __init__(self, value: SupportsIndex) -> None: ...

_Key = Union[Signed, Unsigned, int, str, bytes, bytearray, memoryview]
_LegacyInt = Union[SupportsInt, str, bytes, bytearray]

def i64(value: SupportsIndex) -> Signed: ...
def u64(value: SupportsIndex) -> Unsigned: ...
def _mix64(value: int) -> int: ...
def _mix64_masked(value: int) -> int: ...

class Random:
    seed: int
    index: int
    def __init__(self, seed: Optional[SupportsIndex] = ...) -> None: ...
    def SetSeed(self, localseed: SupportsIndex) -> None: ...
    def scope(self, *prefix: _Key) -> Random: ...
    def raw(self, *key: _Key) -> int: ...
    def rawBatch(self, rows: Iterable[Iterable[_Key]]) -> List[int]: ...
    def int(self, maxvalue: SupportsIndex, *key: _Key) -> int: ...
    def range(
        self, minvalue: SupportsIndex, maxvalue: SupportsIndex, *key: _Key
    ) -> int: ...
    def float01(self, *key: _Key) -> float: ...
    def at2D(
        self, x: SupportsIndex, y: SupportsIndex, namespace: Optional[str] = ...
    ) -> int: ...
    def at3D(
        self,
        x: SupportsIndex,
        y: SupportsIndex,
        z: SupportsIndex,
        namespace: Optional[str] = ...,
    ) -> int: ...
    def chanceRatio(
        self, numerator: SupportsIndex, denominator: SupportsIndex, *key: _Key
    ) -> bool: ...
    def choose(self, items: Sequence[_T], *key: _Key) -> _T: ...
    def stableChoice(
        self, items: Sequence[_T], ids: Sequence[str], *key: _Key
    ) -> _T: ...
    def shuffle(self, items: Iterable[_T], *key: _Key) -> List[_T]: ...
    def sample(
        self, items: Iterable[_T], count: SupportsIndex, *key: _Key
    ) -> List[_T]: ...
    def weightedChoice(
        self, items: Sequence[_T], integerWeights: Sequence[SupportsIndex], *key: _Key
    ) -> _T: ...
    def prepareWeightedChoice(
        self, items: Iterable[_T], integerWeights: Iterable[SupportsIndex]
    ) -> PreparedWeightedChoice[_T]: ...
    def NextAt(self, offset: _LegacyInt) -> int: ...
    def NextRawAt(self, offset: _LegacyInt) -> int: ...
    def NextRaw(self) -> int: ...
    def Next(self) -> int: ...
    def NextMaxAt(self, offset: _LegacyInt, maxvalue: _LegacyInt) -> int: ...
    def NextMax(self, maxvalue: _LegacyInt) -> int: ...
    def NextMinMaxAt(
        self, offset: _LegacyInt, minvalue: _LegacyInt, maxvalue: _LegacyInt
    ) -> Optional[int]: ...
    def NextMinMax(
        self, minvalue: _LegacyInt, maxvalue: _LegacyInt
    ) -> Optional[int]: ...
    def NextList(self, length: _LegacyInt) -> List[int]: ...
    def NextListMax(self, length: _LegacyInt, maxvalue: _LegacyInt) -> List[int]: ...
    def NextListMinMax(
        self, length: _LegacyInt, minvalue: _LegacyInt, maxvalue: _LegacyInt
    ) -> List[Optional[int]]: ...

class PreparedWeightedChoice(Generic[_T]):
    def __init__(
        self,
        field: Random,
        items: Iterable[_T],
        integerWeights: Iterable[SupportsIndex],
    ) -> None: ...
    def choose(self, *key: _Key) -> _T: ...
